# Keep all keys server-side in Vercel project environment settings.
# The studio remains in local WebGL preview mode until enabled.
PFP_CONVERTER_ENABLED=false
PFP_3D_API_URL=https://your-provider.example/v1/convert
PFP_3D_API_KEY=replace_with_provider_secret
PFP_STUDIO_ADMIN_TOKEN=replace_with_a_long_random_private_token
